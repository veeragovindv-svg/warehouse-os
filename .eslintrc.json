{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2021
  },
  "globals": {
    "Utils": "readonly",
    "Store": "readonly",
    "Router": "readonly",
    "AuthModule": "readonly",
    "WarehouseApp": "readonly",
    "THREE": "readonly"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": ["warn", { "allow": ["error", "warn"] }],
    "no-undef": "warn",
    "semi": ["error", "always"],
    "eqeqeq": ["error", "always"]
  }
}
